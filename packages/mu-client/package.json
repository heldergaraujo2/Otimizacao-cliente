{
  "name": "@mu-reengineer/client",
  "version": "0.1.0",
  "private": true,
  "description": "MU-REENGINEER client: headless game core (session, world state) plus the browser renderer",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
