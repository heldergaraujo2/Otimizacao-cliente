{
  "name": "@mu-reengineer/server",
  "version": "0.1.0",
  "private": true,
  "description": "MU-REENGINEER headless server: speaks the MU wire protocol (connect server + game server vertical slice)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mu-server": "dist/main.js"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@mu-reengineer/protocol": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
